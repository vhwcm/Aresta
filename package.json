{
  "name": "aresta-ecosystem",
  "version": "1.0.0",
  "description": "Aresta Ecosystem — Root Orchestrator",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d aresta-db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f aresta-db",
    "prisma:generate": "npm --prefix apps/api run prisma:generate",
    "prisma:migrate": "npm --prefix apps/api run prisma:migrate",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev": "concurrently --kill-others-on-fail -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:all": "npm run db:up && npm run dev",
    "test:api": "npm --prefix apps/api test",
    "test:web": "npm --prefix apps/web test",
    "test": "npm run test:api && npm run test:web",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "build": "npm run build:api && npm run build:web",
    "tauri:dev": "npm --prefix apps/web run tauri:dev",
    "tauri:build": "npm --prefix apps/web run tauri:build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2"
  }
}
