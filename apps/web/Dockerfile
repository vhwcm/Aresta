FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm install --ignore-scripts
COPY . .

ARG NUXT_PUBLIC_API_URL=http://localhost:3001
ARG NUXT_PUBLIC_READER_API_URL=http://localhost:3001
ARG NUXT_PUBLIC_MEMORY_API_URL=http://localhost:3001
ARG NUXT_PUBLIC_AI_API_URL=http://localhost:3001
ARG NUXT_PUBLIC_AUTH_API_URL=http://localhost:3001
ARG NUXT_PUBLIC_CANVAS_API_URL=http://localhost:3001
ENV NUXT_PUBLIC_API_URL=$NUXT_PUBLIC_API_URL
ENV NUXT_PUBLIC_READER_API_URL=$NUXT_PUBLIC_READER_API_URL
ENV NUXT_PUBLIC_MEMORY_API_URL=$NUXT_PUBLIC_MEMORY_API_URL
ENV NUXT_PUBLIC_AI_API_URL=$NUXT_PUBLIC_AI_API_URL
ENV NUXT_PUBLIC_AUTH_API_URL=$NUXT_PUBLIC_AUTH_API_URL
ENV NUXT_PUBLIC_CANVAS_API_URL=$NUXT_PUBLIC_CANVAS_API_URL
RUN npm run generate

FROM nginx:1.27-alpine
COPY --from=build /app/.output/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
