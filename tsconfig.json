{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "paths": {
      "~/*": ["./app/*"],
      "@/*": ["./app/*"],
      "foliate-js": ["./lib/foliate-js"]
    }
  },
  "include": ["app/**/*", "lib/**/*", "tests/**/*", "nuxt.config.ts"],
  "exclude": ["node_modules", ".nuxt", "dist"]
}
