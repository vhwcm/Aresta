# Runtime da API
NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://aresta:password@localhost:5432/aresta_db"
DB_PASSWORD=password
# SEGURANÇA: gere com: openssl rand -base64 48
# Obrigatório em produção (mínimo 32 caracteres). O servidor recusará iniciar sem um valor seguro.
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_FORTE_GERADA_COM_OPENSSL_RAND_BASE64_48"
JWT_EXPIRES_IN="7d"
STORAGE_PATH="./storage"
ALLOW_DEV_ANON=false
# CORS: origens permitidas separadas por vírgula. Em dev, deixe vazio para aceitar localhost:3000 e Tauri automaticamente.
ALLOWED_ORIGINS=""

# Inteligência Artificial (Google Gemini)
GEMINI_API_KEY=""
AI_KEY=""
FLASHCARD_AI_KEY=""
DIDACTIC_AI_KEY=""
GEMINI_MODEL="gemini-3.7-flash"
GEMINI_FLASHCARD_MODEL=""
GEMINI_DIDACTIC_MODEL=""
GEMINI_EMBED_MODEL="gemini-embedding-001"
GEMINI_FLASHCARD_API_KEY=""
GEMINI_DIDACTIC_API_KEY=""

# URL pública usada pelo frontend no navegador (em produção na AWS deixe vazio para usar Same-Origin via Caddy)
NUXT_PUBLIC_API_URL=""
NUXT_PUBLIC_READER_API_URL=""
NUXT_PUBLIC_MEMORY_API_URL=""
NUXT_PUBLIC_AI_API_URL=""
NUXT_PUBLIC_AUTH_API_URL=""
NUXT_PUBLIC_CANVAS_API_URL=""

# Provedores de fallback externos
FALLBACK_AI_BASE_URL=""
FALLBACK_AI_API_KEY=""
FALLBACK_AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GROQ_API_KEY=""
IS_PRODUCTION=false

# OAuth 2.0 Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3000/auth/callback"

APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_CLIENT_SECRET=""
APPLE_PRIVATE_KEY=""
APPLE_REDIRECT_URI="http://localhost:3000/auth/callback"

# Serviços legados (vazios no monólito; mantidos para compatibilidade)
AUTH_SERVICE_URL=""
AI_SERVICE_URL=""
MEMORY_SERVICE_URL=""
READER_SERVICE_URL=""
CANVAS_SERVICE_URL=""
PDF2EPUB_API_URL=""
